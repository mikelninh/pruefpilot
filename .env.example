APP_ENV=demo

# Optional model providers
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Controlled production gates. Do not set these true until the evidence exists.
# JSON map: API key -> tenant/actor/role. Store actual values only in the deployment secret manager.
PRUEFPILOT_API_PRINCIPALS={}
ALLOWED_ORIGINS=https://review.example

# Production readiness evidence flags
PRUEFPILOT_OBSERVABILITY_ENABLED=false
PRUEFPILOT_RETENTION_DAYS=
PRUEFPILOT_BACKUP_RESTORE_TESTED=false
PRUEFPILOT_ROLLBACK_READY=false

# Production persistence must be implemented by an external durable store adapter.
# Local SQLite and Vercel /tmp deliberately do not satisfy the production gate.
PRUEFPILOT_DB_PATH=./data/pruefpilot.db
